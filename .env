# Vite `import.meta.env.*` values. Committed — nothing here is a secret.
# (Worker-side secrets live in `.dev.vars`, which is gitignored.)
#
# Cloudflare Turnstile SITE key (public; ships in the client bundle). This
# default is Cloudflare's documented always-pass TEST key, so `npm run dev`
# and the Playwright suite auto-solve the widget. Production and staging set
# the real per-environment site key as a Workers Builds build-time variable
# (see docs/deployment.md).
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

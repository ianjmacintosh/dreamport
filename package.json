{
  "name": "dreamport",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "CLOUDFLARE_ENV=local vite --host",
    "build": "vite build && tsc -b",
    "build:ci": "CLOUDFLARE_ENV=$([ \"$WORKERS_CI_BRANCH\" = main ] && echo prod || echo stage) npm run build",
    "lint": "eslint .",
    "preview": "vite preview --host",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest",
    "test:e2e": "npx playwright test --reporter=list",
    "migrate:dev": "wrangler d1 migrations apply dreamport-dev --env dev --remote",
    "migrate:stage": "wrangler d1 migrations apply dreamport-stage --env stage --remote",
    "migrate:prod": "wrangler d1 migrations apply dreamport-prod --env prod --remote",
    "generate:auth-schema": "node scripts/generate-auth-schema.mjs"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/funnel-display": "^5.3.0",
    "@tanstack/react-router": "^1.170.32",
    "better-auth": "1.7.2",
    "hono": "^4.13.5",
    "kysely": "^0.29.5",
    "kysely-d1": "^0.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.23.1",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260902.1",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.1",
    "@tanstack/router-plugin": "^1.168.35",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "3.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.18",
    "wrangler": "^4.63.0"
  }
}

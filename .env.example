# Vite `import.meta.env.*` values. `.env` is committed with test-key defaults
# that work out of the box; copy a line here into `.env` only to override it
# locally. Nothing here is a secret — Worker-side secrets live in `.dev.vars`.
#
# Cloudflare Turnstile SITE key (public). Default in `.env` is Cloudflare's
# always-pass test key. Real per-environment keys are set as Workers Builds
# build-time variables (see docs/deployment.md). Cloudflare's test keys:
#   pass:  site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
#   fail:  site 2x00000000000000000000AB / secret 2x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

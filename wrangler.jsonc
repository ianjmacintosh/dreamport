{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dreamport",
  "compatibility_date": "2026-02-05",
  "assets": {
    "not_found_handling": "single-page-application",
  },
  // Default vars for `npm run dev` (Miniflare local SQLite, no remote D1).
  // Each named environment below redeclares these — wrangler does not
  // inherit `vars` or bindings into environments.
  "vars": {
    "EMAIL_MODE": "mock",
  },

  // Four environments. `prod` and `stage` are the deploy targets: both
  // resolve to the Worker "dreamport" (the name Workers Builds expects for
  // this repo) and differ only by DB binding. `dev` and `local` are local
  // development modes, both named "dreamport-localhost" so a stray
  // `CLOUDFLARE_ENV=dev`/`local` build can't be deployed onto the production
  // Worker. `local` is pure Miniflare; `dev` binds the remote dreamport-dev
  // database. See docs/deployment.md for how previews, production, and
  // migrations map onto these. Remote `database_id`s are created by
  // `scripts/setup-d1.sh` (`wrangler d1 create`) and committed here — they
  // are not secrets.
  "env": {
    "prod": {
      "name": "dreamport",
      "vars": {
        "EMAIL_MODE": "mock",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dreamport-prod",
          "database_id": "0f2a6296-4fb3-4025-b7d8-0906cfbda0e1",
        },
      ],
    },
    "stage": {
      "name": "dreamport",
      "vars": {
        "EMAIL_MODE": "mock",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dreamport-stage",
          "database_id": "1c11e9b8-b82d-4c9f-bf39-4af52e7ab3c8",
        },
      ],
    },
    "dev": {
      "name": "dreamport-localhost",
      "vars": {
        "EMAIL_MODE": "mock",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dreamport-dev",
          "database_id": "8394c659-6f81-4f97-9332-dcc13ba7505c",
        },
      ],
    },
    // Local-only: `npm run dev` runs with CLOUDFLARE_ENV=local. The
    // non-UUID database_id never resolves to a real Cloudflare database,
    // so the DB binding is always the local Miniflare copy.
    "local": {
      "name": "dreamport-localhost",
      "vars": {
        "EMAIL_MODE": "mock",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dreamport-local",
          "database_id": "local",
        },
      ],
    },
  },
}

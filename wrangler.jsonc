{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dreamport",
  "compatibility_date": "2026-02-05",
  // nodejs_compat: Better Auth uses AsyncLocalStorage (ADR-0002).
  "compatibility_flags": ["nodejs_compat"],
  // Gateway Worker: owns /api/*, forwards everything else to env.ASSETS unchanged.
  "main": "./src/worker/index.ts",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // true, not ["/api/*"], so all routing lives in the Worker and stays testable.
    "run_worker_first": true,
  },
  // main/assets/compatibility_flags inherit into every env below; vars and bindings don't.
  "vars": {
    "EMAIL_MODE": "mock",
  },

  // production/staging: two separate Cloudflare Workers Builds projects
  // ("dreamport" and "dreamport-staging"), both Git-connected to this repo,
  // differing by Worker name, D1 database, and (per-project dashboard
  // secrets) which RESEND_API_KEY etc. they run with.
  // dev/local: local dev, named "dreamport-localhost" so a stray build can't
  // deploy over production. local is pure Miniflare; dev binds remote dreamport-dev.
  // See docs/deployment.md. database_ids are from scripts/setup-d1.sh, not secrets.
  "env": {
    "production": {
      "name": "dreamport",
      // Custom domain (dreamport.ianjmacintosh.com) is the only intended
      // entry point; the workers.dev subdomain isn't in TRUSTED_ORIGINS and
      // has no reason to be publicly reachable.
      "workers_dev": false,
      "vars": {
        "EMAIL_MODE": "mock",
        // Turnstile tokens for production must be solved on this host, and
        // carry the `send-otp` action (see src/worker/turnstile.ts). Not a
        // secret. Staging/local omit this and run on Cloudflare test keys.
        "TURNSTILE_HOSTNAMES": "dreamport.ianjmacintosh.com",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dreamport-prod",
          "database_id": "0f2a6296-4fb3-4025-b7d8-0906cfbda0e1",
        },
      ],
    },
    "staging": {
      "name": "dreamport-staging",
      // Pinned, not left to Cloudflare's default: every branch preview
      // depends on a workers.dev Preview URL existing (see
      // TRUSTED_ORIGINS and docs/deployment.md).
      "workers_dev": true,
      "preview_urls": true,
      "vars": {
        "EMAIL_MODE": "mock",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dreamport-stage",
          "database_id": "1c11e9b8-b82d-4c9f-bf39-4af52e7ab3c8",
        },
      ],
    },
    "dev": {
      "name": "dreamport-localhost",
      "vars": {
        "EMAIL_MODE": "mock",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dreamport-dev",
          "database_id": "8394c659-6f81-4f97-9332-dcc13ba7505c",
        },
      ],
    },
    // database_id "local" is non-UUID, so DB is always the Miniflare copy.
    "local": {
      "name": "dreamport-localhost",
      "vars": {
        "EMAIL_MODE": "mock",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dreamport-local",
          "database_id": "local",
        },
      ],
    },
  },
}
